{
  "name": "upfly",
  "version": "3.0.0",
  "description": "Optimize your repo's images without breaking a reference.",
  "license": "MIT",
  "author": "Rinkal Kumar (https://github.com/ramin-010)",
  "homepage": "https://github.com/upflyjs/upfly#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/upflyjs/upfly.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "image",
    "optimize",
    "webp",
    "avif",
    "codemod",
    "refactor",
    "cli",
    "lighthouse",
    "core-web-vitals"
  ],
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "bin": {
    "upfly": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "!dist/.tsbuildinfo",
    "!dist/**/*.map",
    "schema/",
    "skill/",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --build",
    "prepack": "node ../../tools/prepack.mjs README.md LICENSE",
    "clean": "tsc --build --clean"
  },
  "dependencies": {
    "c12": "3.3.4",
    "confbox": "0.2.4",
    "upfly-core": "workspace:*"
  },
  "devDependencies": {
    "ajv": "^8.20.0"
  }
}
